Dialogue: 0,0:00:00.00,0:00:01.26,Sub,,0,0,0,,‏בואו נמשיך לראות‏
Dialogue: 0,0:00:01.26,0:00:02.60,Sub,,0,0,0,,‏את החדרים הנוספים‏
Dialogue: 0,0:00:02.60,0:00:04.00,Sub,,0,0,0,,‏זה הסלון‏
Dialogue: 0,0:00:06.40,0:00:07.90,Sub,,0,0,0,,‏הסלון גם מואר‏
Dialogue: 0,0:00:07.90,0:00:12.00,Sub,,0,0,0,,‏יש יציאה למרפסת‏
Dialogue: 0,0:00:12.00,0:00:13.95,Sub,,0,0,0,,‏עכשיו נראה את‏
Dialogue: 0,0:00:13.95,0:00:15.30,Sub,,0,0,0,,‏החדר השני‏
Dialogue: 0,0:00:15.30,0:00:17.24,Sub,,0,0,0,,‏היתרון שלו: יש לו‏
Dialogue: 0,0:00:17.24,0:00:19.40,Sub,,0,0,0,,‏גם מרפסת קטנה נוספת‏
Dialogue: 0,0:00:19.40,0:00:21.25,Sub,,0,0,0,,‏לא מרפסת גדולה, אבל‏
Dialogue: 0,0:00:21.25,0:00:23.40,Sub,,0,0,0,,‏מרפסת שמכניסה הרבה אור‏
Dialogue: 0,0:00:23.40,0:00:26.09,Sub,,0,0,0,,‏עכשיו אנחנו בחדר שיש‏
Dialogue: 0,0:00:26.09,0:00:28.10,Sub,,0,0,0,,‏לו יציאה למרפסת‏
Dialogue: 0,0:00:28.10,0:00:31.19,Sub,,0,0,0,,‏המרפסת חזיתית, לרחוב חד‏
Dialogue: 0,0:00:31.19,0:00:33.20,Sub,,0,0,0,,‏סטרי ויחסית שקט‏
